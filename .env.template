# Starbase environment template — copy to .env and fill in values.
# Used by the root docker-compose.yaml (full local stack) and start-script.sh.

# ── Runtime mode ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEV_MODE=false
# Set BACKEND_DEV_MODE=true to run backend/start-script.sh in reload mode
BACKEND_DEV_MODE=false

# ── Backend compute split ─────────────────────────────────────────────────────
# Local full-stack (root docker-compose): http://backend:8001
# Institute machine via Tailscale:        http://<tailscale-ip>:8001
BACKEND_API_URL=http://backend:8001
BACKEND_API_KEY=change-me-strong-secret
# Port the backend FastAPI process listens on inside its container
BACKEND_PORT=8001

# DATA_DIR: absolute path on HOST to SQLite files + BLAST/HMM data.
# Mounted into backend container at /home/starbase/src/database/db.
# Example: DATA_DIR=/mnt/starbase-data
DATA_DIR=./src/database/db

# ── API keys ──────────────────────────────────────────────────────────────────
IPSTACK_API_KEY=
MAINTENANCE_TOKEN=

# ── Celery / Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis-backend:6379/0
CELERY_RESULT_BACKEND=redis://redis-backend:6379/0

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TIMEOUT=300

# ── URLs (frontend) ───────────────────────────────────────────────────────────
HOME_URL=/
WIKI_URL=/wiki
BLAST_URL=/blast
ABOUT_URL=/about
SYNTENY_URL=/synteny
SUBMIT_URL=/submit
METRICS_URL=/metrics

# ── Starfish pipeline (backend / monolith only) ────────────────────────────────
# Path to a checked-out starfish-nextflow (main branch) on this machine.
STARFISH_NEXTFLOW_PATH=
# Must match a profile in starfish-nextflow's nextflow.config: conda, local, test,
# standard, hpc (comma-joinable). Default "local,standard": prepends a
# pre-built conda env's bin/ onto PATH per-task -- set STARFISH_ENV_PATH
# below. ("conda" instead has Nextflow build+cache a fresh per-process env
# via mamba on every run; confirmed unreliable when launched from a
# non-activated shell, which is how this pipeline is actually invoked.)
STARFISH_NEXTFLOW_PROFILE=local,standard
# Absolute path to a pre-built conda env with `starfish` installed --
# passed as --starfish_env under the "local" profile.
STARFISH_ENV_PATH=
# starfish-nextflow's --starfish_aux/--starfish_db (and --starfish_env's
# own default) are hardcoded to one specific machine's path in its
# nextflow.config -- set these to the aux/db dirs bundled with your own
# `starfish` conda install (normally STARFISH_ENV_PATH/{aux,db}) if that
# default doesn't resolve on this host. Leave blank to use the pipeline's
# own default.
STARFISH_AUX_PATH=
STARFISH_DB_PATH=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
